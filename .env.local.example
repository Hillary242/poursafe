# The SAME Supabase project as the Ops Tracker (for now): PourSafe's reports
# land in the same database, so they appear in the office Safety log.
# Copy these two from the Ops Tracker's Vercel project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

